---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "Blog";
---

<BaseLayout pageTitle={pageTitle}>
    <main class="mx-auto w-full max-w-3xl px-5 py-12 sm:px-8 lg:px-10">
        <section class="space-y-4">
            <h1 class="font-mono text-3xl font-medium text-zinc-100">Blog</h1>
            <h2 class="text-sm text-zinc-400 sm:text-base">Mi blog de aprendizaje sobre Astro</h2>
            <p class="max-w-2xl text-sm leading-7 text-zinc-300">
                Aquí es donde publicaré acerca de mi viaje aprendiendo Astro.
            </p>
            <ul class="space-y-2 pt-2">
                <li>
                    <a class="font-mono text-sm text-zinc-300 transition-colors hover:text-zinc-100" href="/posts/post-1/">Publicación 1</a>
                </li>
            </ul>
        </section>
    </main>
</BaseLayout>
