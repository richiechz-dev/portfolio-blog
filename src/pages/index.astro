---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "About me";
const identity = {
    name: "Ricardo Chavez",
    country: "Mexico City",
    occupation: "Software Engineer",
    hobbies: ["Dibujante", "Artista Visual"],
};
const skills = [
    "Python",
    "FastAPI",
    "PostgreSQL",
    "Docker",
    "Flutter",
    "Linux Administration",
    "Git",
    "REST APIs",
];
---

<BaseLayout pageTitle={pageTitle}>
    
    <p class="name">{identity.name}</p>
    <h1>Subtitulo</h1>
    <p class="tagline mono">richiechz-dev · Mexico City</p>

    <p class="bio">
        I build backends, automate things, and occasionally make apps.
        Comfortable working with <em>APIs, data pipelines, and Linux</em> — curious
        about cloud infrastructure and how systems talk to each other.
    </p>

    <p class="label">Stack</p>
    <ul>
        {skills.map((skill) => <li>{skill}</li>)}
    </ul>
    
</BaseLayout>
