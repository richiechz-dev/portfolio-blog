---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroIntro from "../components/HeroIntro.astro";
import StackList from "../components/StackList.astro";

import "../styles/global.css";

const pageTitle = "About me";
const identity = {
    name: "Ricardo Chavez Merino",
    country: "Mexico City",
    occupation: "Software Engineer",
    hobbies: ["Dibujante", "Artista Visual"],
};
const skills = [
    "Python",
    "FastAPI",
    "PostgreSQL",
    "Docker",
    "Flutter",
    "Linux Administration",
    "Git",
    "REST APIs",
];

---

<BaseLayout pageTitle={pageTitle}>
    <!--
      `main` usa `pt-*` para separar el contenido del header sin tocar la navegación.
      `max-w-3xl mx-auto` centra todo y `px-*` mantiene el margen lateral en móvil.
    -->
    <main class="mx-auto w-full max-w-3xl px-5 pt-16 pb-8 sm:px-8 sm:pt-20 sm:pb-10 lg:px-10">
        <!-- `space-y-6` define la distancia vertical entre el bloque principal y el stack. -->
        <section class="space-y-6">
            <HeroIntro
                name={identity.name}
                country={identity.country}
                bio="I build backends, automate things, and occasionally make apps. Comfortable working with APIs, data pipelines, and Linux — curious about cloud infrastructure and how systems talk to each other."
            />
            <StackList items={skills} />
        </section>
    </main>
</BaseLayout>
