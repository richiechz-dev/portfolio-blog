---
const { title, description, stack = [], href, featured = false } = Astro.props;
---

<article class="rounded-xl border border-zinc-800 bg-zinc-950 p-5 sm:p-6">
    <div class="space-y-4">
        <div class="flex items-start justify-between gap-4">
            <div class="space-y-1">
                <p class="font-mono text-lg font-medium tracking-[-0.01em] text-zinc-100">
                    {title}
                </p>
                {featured && (
                    <p class="font-mono text-[0.72rem] uppercase tracking-[0.08em] text-emerald-400">
                        featured
                    </p>
                )}
            </div>

            {href && (
                <a class="font-mono text-xs text-zinc-400 transition-colors hover:text-zinc-100" href={href}>
                    View
                </a>
            )}
        </div>

        <p class="max-w-2xl text-sm leading-7 text-zinc-300">
            {description}
        </p>

        {stack.length > 0 && (
            <ul class="flex flex-wrap gap-2">
                {stack.map((item) => (
                    <li class="rounded border border-zinc-800 px-3 py-1 font-mono text-[0.75rem] text-zinc-300">
                        {item}
                    </li>
                ))}
            </ul>
        )}
    </div>
</article>
